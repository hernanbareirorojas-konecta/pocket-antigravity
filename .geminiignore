# ==============================================================================
# pocket-antigravity Ignore Rules (.geminiignore / .antigravityignore)
# Prevents Google Antigravity and Gemini indexers from ingesting huge dependency
# directories, lockfiles, build artifacts, and binaries into LLM context.
# ==============================================================================

# Dependencies & Package Managers
node_modules/
vendor/
.venv/
venv/
env/
Pods/
.pnp/
.pnp.js

# Lockfiles (Huge JSON/YAML that burn thousands of tokens if indexed)
package-lock.json
pnpm-lock.yaml
yarn.lock
bun.lockb
Cargo.lock
poetry.lock
Pipfile.lock
composer.lock
Gemfile.lock

# Build & Compilation Artifacts
dist/
build/
out/
target/
bin/
obj/
.next/
.nuxt/
.output/
.svelte-kit/
*.class
*.jar
*.war
*.exe
*.dll
*.so
*.dylib

# Test Coverage & Diagnostics
coverage/
htmlcov/
.nyc_output/
*.lcov
.tox/
.nox/

# Caches & Temporary Files
__pycache__/
*.pyc
.pytest_cache/
.mypy_cache/
.ruff_cache/
.turbo/
.cache/
.parcel-cache/
*.tsbuildinfo

# Minified Assets & Source Maps
*.min.js
*.min.css
*.map

# Media & Binary Assets
*.png
*.jpg
*.jpeg
*.gif
*.ico
*.svg
*.mp4
*.webm
*.mov
*.zip
*.tar
*.tar.gz
*.tgz
*.rar
*.7z
*.wasm
*.pdf
*.ttf
*.otf
*.woff
*.woff2

# Sensitive Files & Secrets
.env
.env.*
*.local
credentials*.json
*.pem
*.key

# IDE & OS Metadata
.idea/
.vscode/
.DS_Store
Thumbs.db
*.swp

